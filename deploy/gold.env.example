# Shadow/reference configuration only; no Gold execution activation switch exists.
MONATISE_GOLD_TRADINGVIEW_REFERENCE_ENABLED=false
# Existing scanner gate; Gold routing does not depend on FlashAlpha root selection.
MONATISE_FTMO_FUTURES_SCAN_ENABLED=true
# Placeholder for a separately authorized, operator-injected SDK client.
# The runtime does not read this key or start paid streams automatically.
DATABENTO_API_KEY=YOUR_DATABENTO_API_KEY

# Path to an authoritative, reviewed gold-broker-sessions-v1 JSON manifest.
# Empty keeps historical timezone qualification unavailable; never use test fixtures.
MONATISE_GOLD_SESSION_MANIFEST=
